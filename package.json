{
  "name": "velocityai",
  "private": true,
  "scripts": {
    "build": "dotenv -- turbo build",
    "start": "pnpm --filter @shipflow/web start",
    "dev": "dotenv -- turbo dev",
    "dev:all": "dotenv -- concurrently --names \"turbo,ngrok\" --prefix-colors \"cyan,yellow\" \"turbo dev\" \"ngrok http --domain=setback-datebook-uniformed.ngrok-free.dev 3000\"",
    "dev:tunnel": "dotenv -- ngrok http --domain=setback-datebook-uniformed.ngrok-free.dev 3000",
    "db:generate": "dotenv -- turbo db:generate",
    "db:migrate": "dotenv -- turbo db:migrate",
    "db:push": "dotenv -- turbo db:push",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.3",
    "concurrently": "^9.1.2",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.2",
    "dotenv-cli": "^11.0.0"
  },
  "version": "0.0.1"
}
